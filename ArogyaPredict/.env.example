# ArogyaPredict - Environment Variables Configuration
# Copy this to .env and fill in your API keys

# OpenWeather API Key
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# AQICN API Key
# Get from: https://aqicn.org/data-platform/token/
AQICN_API_KEY=

# Calendarific API Key (for holidays/events)
# Get from: https://calendarific.com/
CALENDARIFIC_API_KEY=

# Hospital Location Coordinates (Default: Mumbai, India)
HOSPITAL_LAT=19.2183
HOSPITAL_LON=72.9781
HOSPITAL_COUNTRY=IN

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Model Configuration
RANDOM_STATE=42
TEST_SIZE=0.2
